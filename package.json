{
  "name": "learned-today",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:start": "pnpm dlx supabase start",
    "db:reset": "pnpm dlx supabase db reset",
    "db:types": "pnpm dlx supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "tokens": "node scripts/build-tokens.mjs",
    "telegram:commands": "node --env-file=.env scripts/set-telegram-commands.mjs"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.6",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "marked": "^18.1.1",
    "nitro": "3.0.260903-beta",
    "solid-js": "^1.9.17",
    "solid-tiptap": "^0.8.0",
    "vite": "^8.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.0.0",
    "lefthook": "2.2.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  }
}
