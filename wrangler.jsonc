{
  "name": "learned-today",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  // process.env.* in the server code (SUPABASE_SECRET_KEY, TELEGRAM_*) needs both flags.
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": { "directory": ".output/public", "binding": "ASSETS" },
  // Per-IP limits, read by src/middleware.ts. Counted per Cloudflare location, so they are loose by design:
  // they stop one client from hammering Supabase through the Worker, not a crowd. Phones behind one carrier
  // address share a budget, hence the room. namespace_id is any number unique within the account.
  "ratelimits": [
    // Pages and server functions (feed, search as you type, reactions, publishing).
    { "name": "RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 10 } },
    // RSS readers poll every few minutes; this is far above that.
    { "name": "RATE_LIMIT_RSS", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ]
}
