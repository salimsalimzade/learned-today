# Copy to .env. The app needs a Supabase project (local: `pnpm db:start`, then `supabase status` for the keys).

# Public site URL, used for absolute links in RSS and Telegram messages.
VITE_SITE_URL=http://localhost:3000

# Supabase (Project settings → API Keys, or `supabase status` locally).
# The publishable key (sb_publishable_…) is safe in the browser; RLS protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server only (sb_secret_…), bypasses RLS. Used by the Telegram webhook to write subscriptions.
SUPABASE_SECRET_KEY=

# Telegram bot (from @BotFather)
VITE_TELEGRAM_BOT_USERNAME=tildailybot
TELEGRAM_BOT_TOKEN=
# Any random string. Pass it as secret_token when you call setWebhook.
TELEGRAM_WEBHOOK_SECRET=
