# Copy to .env. Leave the Supabase values empty to run on mock data.

# Public site URL, used for absolute links in RSS and Telegram messages.
VITE_SITE_URL=http://localhost:3000

# Supabase (Project settings → API). The anon key is safe in the browser; RLS protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only. Used by the Telegram webhook to write subscriptions.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot (from @BotFather)
VITE_TELEGRAM_BOT_USERNAME=learned_today_bot
TELEGRAM_BOT_TOKEN=
# Any random string. Pass it as secret_token when you call setWebhook.
TELEGRAM_WEBHOOK_SECRET=
